rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for hardened security
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation blueprints for company entities
    function isValidProduct(data) {
      return data.name is string && data.name.size() <= 150
        && (data.sku == null || (data.sku is string && data.sku.size() <= 64))
        && (data.quantity == null || data.quantity is number)
        && (data.buyingPrice == null || data.buyingPrice is number);
    }

    function isValidInvoice(data) {
      return data.amount is number
        && (data.customer == null || (data.customer is string && data.customer.size() <= 200))
        && (data.items == null || data.items is list);
    }

    function isValidBOM(data) {
      return data.name is string && data.name.size() <= 200
        && (data.components == null || data.components is list);
    }

    function isValidProductionOrder(data) {
      return data.status is string && data.status.size() <= 64
        && (data.quantity == null || data.quantity is number);
    }

    // Core rule matchers for Company scoping
    match /companies/{companyId} {
      allow read: if true;
      allow write: if isSignedIn();

      // Products subcollection rules
      match /products/{productId} {
        allow read: if true;
        allow create, update: if isValidId(productId) && isValidProduct(incoming());
        allow delete: if isSignedIn();
      }

      // Invoices subcollection rules
      match /invoices/{invoiceId} {
        allow read: if true;
        allow create, update: if isValidId(invoiceId) && isValidInvoice(incoming());
        allow delete: if isSignedIn();
      }

      // Purchase Orders subcollection rules
      match /purchaseOrders/{poId} {
        allow read: if true;
        allow create, update: if isValidId(poId) && incoming().items is list;
        allow delete: if isSignedIn();
      }

      // BOMs subcollection rules
      match /boms/{bomId} {
        allow read: if true;
        allow create, update: if isValidId(bomId) && isValidBOM(incoming());
        allow delete: if isSignedIn();
      }

      // Production orders subcollection rules
      match /production_orders/{orderId} {
        allow read: if true;
        allow create, update: if isValidId(orderId) && isValidProductionOrder(incoming());
        allow delete: if isSignedIn();
      }

      // Catch-all for any other production-hub subcollections
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
  }
}
