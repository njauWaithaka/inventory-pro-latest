rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for hardened security
    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isDemoCompany(companyId) {
      return isValidId(companyId) && (companyId == 'demo_workspace' || companyId.matches('^demo_.*'));
    }

    // Anonymous visitors can access their own isolated demo workspace (where companyId == request.auth.uid)
    // Non-anonymous users can access authenticated companies
    // Unauthenticated guest demo sessions can access demo workspaces matching demo_* or demo_workspace
    function isAllowedCompany(companyId) {
      return (isSignedIn() && (
        (isAnonymous() && request.auth.uid == companyId) ||
        (!isAnonymous())
      )) || isDemoCompany(companyId);
    }

    // Health check endpoint for test connection
    match /test/{testId} {
      allow read: if true;
    }

    // User profile access:
    // Anonymous users can only access their own user document
    // Registered users can read team profiles and write their own
    // Guest demo users can read and write their isolated demo user profile
    match /users/{userId} {
      allow read: if (isSignedIn() && (request.auth.uid == userId || !isAnonymous())) || userId.matches('^demo_.*');
      allow write: if (isSignedIn() && request.auth.uid == userId) || userId.matches('^demo_.*');
    }

    // Core rule matchers for Company scoping
    match /companies/{companyId} {
      allow read: if isAllowedCompany(companyId);
      allow write: if isAllowedCompany(companyId);

      // All subcollections inside the company (products, sales, receipts, invoices, etc.)
      match /{subcollection}/{docId} {
        allow read: if isAllowedCompany(companyId);
        allow write: if isAllowedCompany(companyId);
      }
    }
  }
}
